# === Droidspaces 所需内核特性补全（参考片段 / 文档用）===
# 实际构建由 workflow 用 `scripts/config --enable` 在设备真实配置的基础上逐项开启，
# 这里列出全部要开启的符号及原因，便于核对。

# ---- 必选（Droidspaces [MUST HAVE] 缺失项）----
CONFIG_PID_NS=y            # 进程命名空间隔离（MUST，原 = not set）
# CONFIG_IPC_NS 依赖 CONFIG_SYSVIPC，二者都要开：
CONFIG_SYSVIPC=y           # IPC_NS 的前置依赖（原 = not set，导致 IPC_NS 连选项都没有）
CONFIG_IPC_NS=y            # 进程间通信隔离（MUST，原缺失）

# ---- 推荐 / 可选（补齐容器能力，便于验证与长期使用）----
CONFIG_USER_NS=y           # Sandboxing：非特权 Docker/Podman/浏览器沙箱（原 = not set）
CONFIG_CGROUP_PIDS=y       # 进程数限制 --pids-limit（原 = not set）
CONFIG_CFS_BANDWIDTH=y     # CPU 限制 --cpus（原 = not set）
CONFIG_DEVTMPFS=y          # 硬件访问模式（原 = not set）
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MACVLAN=y           # --net=macvlan（原 = not set）
CONFIG_IP6_NF_NAT=y        # IPv6 NAT：--net=nat（原 = not set）
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# ---- 基础设施兜底（多数 GKI 已默认开，这里确认）----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_FUSE_FS=y
CONFIG_TUN=y
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---- 把当前配置暴露到 /proc/config.gz，方便回设备验证 ----
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
