# === V12 全功能配置增量 (基于设备真实 w210ds_full.config 追加) ===
# 应用方式: workflow 解析本文件每行 CONFIG_X=y, 去掉 CONFIG_ 前缀后 `scripts/config --enable X`
# 原则: 只追加纯软件特性(命名空间/cgroup/虚拟化/文件系统/网络/安全/BPF追踪), 不碰板级硬件驱动,
#       不开启 KASAN/KCSAN/UBSAN/LOCKDEP/DEBUG_LIST 等会导致启动失败或巨慢的重型调试项。
#       vermagic / MODVERSIONS / LTO 处理由 workflow 单独负责, 这里不动。

# ---- 命名空间 (全开, 含 Droidspaces 既有项) ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

# ---- cgroups (全开) ----
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
# [V12-safe 关闭] CONFIG_CGROUP_PIDS=y   # 原因: 改 task_struct 布局(加 cgroup_pids 指针) -> 其后字段偏移整体搬 -> 原厂.ko 全崩
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
# [V12-safe 关闭] CONFIG_CGROUP_PERF=y   # 原因: 同上
# [V12-safe 关闭] CONFIG_CGROUP_NET_CLASSID=y   # 原因: 同上
CONFIG_CGROUP_NET_PRIO=y
# [V12-safe 关闭] CONFIG_CGROUP_HUGETLB=y   # 原因: cgroup 子系统扩展, 对目标无价值且有结构影响面
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
# [V12-safe 关闭] CONFIG_CFS_BANDWIDTH=y   # 原因: 改 cfs_rq/sched_entity -> 直接打崩原厂 unisoc-sched.ko
CONFIG_BLK_CGROUP=y

# ---- 内存/压缩/大页 (纯软件) ----
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
# [V12-safe 关闭] CONFIG_KSM=y   # 原因: 内存合并, 非必需
# [V12-safe 关闭] CONFIG_ZSWAP=y   # 原因: 改内存回收行为, 非必需(保留 ZRAM/ZSMALLOC)
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y

# ---- KVM 主机 + VirtIO 客户机 (全开) ----
CONFIG_KVM=y
CONFIG_KVM_ARM64=y
CONFIG_KVM_ARM64_VHE=y
CONFIG_KVM_GENERIC_DIRTYLOG_READ_PROTECT=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_MEM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_9P_FS_SECURITY=y
CONFIG_VHOST=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y
CONFIG_VHOST_IOTLB=y
CONFIG_VHOST_USER=y

# ---- 文件系统 (纯软件, 无硬件依赖) ----
CONFIG_FUSE_FS=y
CONFIG_CUSE=y
CONFIG_OVERLAY_FS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_XFS_QUOTA=y
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_NFSD=y
CONFIG_NFSD_V4=y
CONFIG_EXFAT_FS=y
CONFIG_UDF_FS=y
CONFIG_ISO9660_FS=y
# [size/oot-risk] dropped: CONFIG_JFS_FS=y
# [size/oot-risk] dropped: CONFIG_REISERFS_FS=y
# [size/oot-risk] dropped: CONFIG_GFS2_FS=y
# [size/oot-risk] dropped: CONFIG_OCFS2_FS=y
# [size/oot-risk] dropped: CONFIG_NILFS2_FS=y
# [size/oot-risk] dropped: CONFIG_ECRYPT_FS=y

# ---- 容器/虚拟网络 (全开) ----
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_GTP=y
CONFIG_MACSEC=y
CONFIG_WIREGUARD=y
CONFIG_IFB=y
CONFIG_DUMMY=y
CONFIG_BONDING=y
CONFIG_TEAM=y

# ---- Netfilter / nftables (全开, Docker/容器网络) ----
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_IPV6=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_BRIDGE_META=y
CONFIG_NFT_BRIDGE_VLAN=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_ACCT=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNLABEL=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y

# ---- 流量控制 (全开) ----
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_FW=y
CONFIG_NET_CLS_FLOW=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_ACT_NAT=y
CONFIG_NET_ACT_SKBEDIT=y
CONFIG_NET_EMATCH=y

# ---- 安全模块 (全开, 但 DEFAULT 仍留给 SELinux, 不改 Android 启动行为) ----
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
# [size/oot-risk] dropped: CONFIG_SECURITY_SMACK=y
# [V12-safe 关闭] CONFIG_SECURITY_APPARMOR=y   # 原因: 非必需 LSM(Android 用 SELinux)
# [size/oot-risk] dropped: CONFIG_SECURITY_TOMOYO=y
# [V12-safe 关闭] CONFIG_SECURITY_YAMA=y   # 原因: 非必需 LSM
# [V12-safe 关闭] CONFIG_SECURITY_LOCKDOWN_LSM=y   # 原因: 内核锁定, 限制运行时操作
# [V12-safe 关闭] CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y   # 原因: 同上(更早挂钩)
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
CONFIG_INTEGRITY=y
CONFIG_INTEGRITY_AUDIT=y
# [V12-safe 关闭] CONFIG_IMA=y   # 原因: 完整性度量; IMA_APPRAISE 可拒绝执行未签名二进制 -> kill init
# [V12-safe 关闭] CONFIG_IMA_APPRAISE=y   # 原因: 同上
# [V12-safe 关闭] CONFIG_EVM=y   # 原因: 扩展验证, 改变 inode 安全域行为
CONFIG_ENCRYPTED_KEYS=y
CONFIG_KEYS=y

# ---- BPF / 追踪 / 调试 (纯软件, 安全) ----
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
# [V12-safe 关闭] CONFIG_BPF_LSM=y   # 原因: 改变 LSM 钩子链
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_DYNAMIC_FTRACE_WITH_REGS=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_STACK_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_BLK_DEV_IO_TRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_TRACEPOINTS=y
CONFIG_TRACING=y
CONFIG_RING_BUFFER=y
CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_PROC_KCORE=y
CONFIG_MAGIC_SYSRQ=y

# ---- 杂项软件特性 ----
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BINFMT_MISC=y
CONFIG_COMPAT=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ASHMEM=y
# [V12-safe 关闭] CONFIG_HUGETLBFS=y   # 原因: 同上
# [V12-safe 关闭] CONFIG_HUGETLB_PAGE=y   # 原因: 改 mm 大页行为, 非必需
CONFIG_WATCH_QUEUE=y
CONFIG_IO_URING=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KALLSYMS_BASE_RELATIVE=y
CONFIG_CORE_DUMP_DEFAULT_ELF_HEADERS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---- 跨平台玩机补充 (V10 + 虚拟化全开 之上追加) ----
CONFIG_VIRTIO_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_XZ=y
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_NTFS_FS=y
