config SC888X_CHARGER
	tristate "SC8886X Buck Boost Charger driver"
	default n
	help
		If you say yes here you will get support for the SC8886/SC8886S/SC8886A/SC8885/SC8885S/SC8885A Buck Boost Charger.
		This driver can give support for SC8886/SC8886S Interface.

