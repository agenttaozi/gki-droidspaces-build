config ZTE_SND_SOC_FS1599
        tristate "SoC Audio for FourSemi PA FS1599N"
        depends on I2C
    help
        This option enables support for FourSemi PA.


config ZTE_SND_SOC_FSMXXX_USE_SCENE_SWITCH
        tristate "SoC Audio for FourSemi PA SCENE SWITCH"
        depends on I2C
    help
        This option enables support for FourSemi PA.