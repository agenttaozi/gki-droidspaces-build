/ {
	fragment {
		target-path = "/";
		__overlay__ {
			lcds {
				lcd_boe_rm69220_ramless_boe_mipi_hdplus_eswin: lcd_boe_rm69220_ramless_boe_mipi_hdplus_eswin {
					zte,lcd-init-code-version = "20241220_vrr";

					zte,lcd-backlight-register-bit-length = <0x0C>;
					zte,lcd-backlight-min-value = <0x01>;
					zte,lcd-disable-ssc;
					zte,panel-name = "lcd_boe_rm69220_ramless_boe_mipi_hdplus_eswin";
					zte,lcd-delay-open-bl-value = <51>;
					zte,lcd-disable-mipi-hop;
					zte,lcd-reset-down-before-vsp;

					sprd,dsi-work-mode = <1>;
					sprd,dsi-lane-number = <4>;
					sprd,dsi-color-format = "dsc";
					//sprd,dpi-clk-div = <0>;
					//sprd,video-lp-cmd-enable = <0>;
					//sprd,video-lp-en-mode = <3>;
					//sprd,hporch-lp-disable = <0>;
					sprd,slice-width = <540>;
					sprd,slice-height = <13>;
					sprd,output-bpc = <8>;
					sprd,dsc-enable = <1>;
					sprd,dual-dsi-enable = <0>;
					sprd,need-vblank-adj;
					sprd,vblank-adj-val = <28>;

					sprd,phy-bit-clock = <1120000>;
					sprd,phy-escape-clock = <20000>;/* kHz */

					sprd,width-mm = <7080>;
					sprd,height-mm = <15682>;

					sprd,esd-check-enable = <1>;/* 0:close , 1:open */
					sprd,esd-check-mode = <1>;/* 0:REG ,1:TE  */
					sprd,esd-check-period = <2000>;
					sprd,esd-check-register = <0x0A>;
					sprd,esd-check-value = <0x9C>;
					sprd,dphy-taget-val = <5>;
					/* vrr config parameters */
					sprd,vrr-enabled;
					sprd,vrr-max-layers = <2>;

					sprd,reset-on-sequence = <1 5>, <0 10>, <1 35>;
					sprd,reset-off-sequence = <1 20>;

					sprd,use-dcs-write;
