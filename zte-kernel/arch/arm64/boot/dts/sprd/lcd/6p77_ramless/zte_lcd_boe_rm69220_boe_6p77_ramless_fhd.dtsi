					display-timings {
						native-mode = <&lcd_boe_rm69220_ramless_boe_fhd_timing0>;
						lcd_boe_rm69220_ramless_boe_fhd_timing0: timing0 {
							clock-frequency = <384000000>;
							hactive = <1080>;
							vactive = <2392>;
							hback-porch = <92>;
							hfront-porch = <92>;
							hsync-len = <4>;
							vsync-len = <4>;
							vback-porch = <52>;
							vfront-porch = <2592>;
						};

