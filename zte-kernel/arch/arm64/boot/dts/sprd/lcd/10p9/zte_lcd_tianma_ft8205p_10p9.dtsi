/ {
	fragment {
		target-path = "/";
		__overlay__ {
			lcds {
				lcd_tianma_ft8205p_mipi_hdplus_focal: lcd_tianma_ft8205p_mipi_hdplus_focal {
					zte,lcd-init-code-version = "20251020_lpwg_sequence";

					zte,lcd-backlight-register-bit-length = <0x0C>;
					zte,lcm_backlight_curve_mode = "lcd_brightness_max_450_lux";
					zte,lcd_bl_vsp_vsn_voltage = <0x14>;
					zte,lcd-disable-ssc;
					zte,panel-name = "lcd_tianma_ft8205p_mipi_hdplus_focal";
					zte,lcd-delay-open-bl-value = <34>;
					zte,lcd-version-v000;
					zte,lcd-disable-mipi-hop;
					zte,dsc-block-pred-disable = <1>;/* 0:close default , 1:open */
					zte,lcd-reset-down-before-vsp;

					sprd,dsi-work-mode = <1>;
					sprd,dsi-lane-number = <4>;
					sprd,dsi-color-format = "dsc";
					sprd,dpi-clk-div = <0>;
					//sprd,video-lp-cmd-enable = <1>;
					//sprd,video-lp-en-mode = <3>;
					sprd,hporch-lp-disable = <0>;
					sprd,vrr-enabled;
					sprd,vrr-max-layers = <3>;
					sprd,slice-width = <660>;
					sprd,slice-height = <44>;
					sprd,output-bpc = <8>;
					sprd,dsc-enable = <1>;
					sprd,dual-dsi-enable = <0>;

					sprd,phy-bit-clock = <1152000>;
					sprd,phy-escape-clock = <20000>;/* kHz */

					sprd,width-mm = <14680>;
					sprd,height-mm = <23488>;

					sprd,esd-check-enable = <1>;/* 0:close , 1:open */
					sprd,esd-check-mode = <4>;/* 0:REG ,1:TE  */
					sprd,esd-check-period = <2000>;
					sprd,esd-check-register = <0x0A>;
					sprd,esd-check-value = <0x9C>;

					sprd,dphy-taget-val = <5>;

					sprd,reset-on-sequence = <1 5>, <0 2>, <1 50>;
					sprd,reset-off-sequence = <1 20>;

					sprd,use-gen-write;
					sprd,initial-command = [
29 00 00 03 41 5A 09
