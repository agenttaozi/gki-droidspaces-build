					];

					sprd,sleep-in-command = [
						39 05 00 02 28 00
						39 78 00 02 10 00
						39 00 00 02 04 5A
						39 14 00 02 05 5A
						];
					sprd,sleep-out-command = [
						05 78 00 01 11
						05 14 00 01 29
						];
					display-timings {
						native-mode = <&lcd_tianma_ft8205p_fhd_timing0>;
						lcd_tianma_ft8205p_fhd_timing0: timing0 {
							clock-frequency = <384000000>;
							hactive = <1320>;
							vactive = <2112>;
							hback-porch = <198>;
							hfront-porch = <200>;
							vback-porch = <544>;
							vfront-porch = <1020>;
							hsync-len = <20>;
							vsync-len = <6>;
						};
						lcd_tianma_ft8205p_fhd_timing1: timing1 {
							clock-frequency = <384000000>;
							hactive = <1320>;
							vactive = <2112>;
							hback-porch = <198>;
							hfront-porch = <200>;
							vback-porch = <136>;
							vfront-porch = <200>;
							hsync-len = <20>;
							vsync-len = <6>;
						};
					};
				};
			};
		};
	};
};
