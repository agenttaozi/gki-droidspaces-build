&i2c2 {
	status = "okay";
	aw9160x_sar@13 {
		compatible = "awinic,aw9610x_sar";
		reg = <0x13>;
		sar-num = < 0 >;
		irq-gpio = <&ap_gpio 132 0>;
		chip_name = "AW96103";
		channel_use_flag = <0x03>;
		status = "okay" ;
	};

	stk501xx_sar@2C {
		compatible = "stk,stk501xx";
		reg = <0x2C>;

		stk501xx,irq-gpio = <&ap_gpio 132 0>;
		chip_name = "STK50153";
		status = "okay" ;
	};
};
