/* add zte sar start */
&i2c2 {
	status = "okay";
	aw9160x_sar@12 {
		compatible = "awinic,aw9610x_sar";
		reg = <0x12>;
		sar-num = < 0 >;
		irq-gpio = <&ap_gpio 132 0>;
		chip_name = "AW96103";
		channel_use_flag = <0x03>;
		status = "okay" ;
	};
	
	stk501xx_sar@28 {
		compatible = "stk,stk501xx";
		reg = <0x28>;

		stk501xx,irq-gpio = <&ap_gpio 132 0>;
		stk501xx,phase_use_flag = <0x03>;
		chip_name = "STK50153";
		status = "okay" ;
	};
};

/* add zte sar end */
